{
  "name": "Royal Katsic MD",
  "description": "ROYAL KATSIC MD - Powerful WhatsApp MD Bot by Royal Katsic (Baileys)",
  "repository": "https://github.com/RoyalKatsic1/R-Katsic-Wa-Bot",
  "keywords": ["whatsapp", "baileys", "royal-katsic-md", "bot", "node", "whatsapp-bot"],
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs.git"
    }
  ],
  "env": {
    "SESSION_ID": {
      "description": "RoyalKatsic session string (e.g. RoyalKatsic!<base64_compressed_data>) - Get from your session generator",
      "required": false,
      "value": ""
    },
    "OWNER_NUMBER": {
      "description": "Your WhatsApp number without + (e.g. 256754214612)",
      "required": false,
      "value": "256754214612"
    },
    "PREFIX": {
      "description": "Bot prefix",
      "required": false,
      "value": "."
    }
  }
}
